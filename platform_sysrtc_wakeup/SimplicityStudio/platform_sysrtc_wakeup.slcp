# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: platform_sysrtc_wakeup
label: platform_sysrtc_wakeup

description: |
  This project represents how to use the SYSRTC compare mode and use the PRS to toggle a LED.

category: Example|Platform
package: Platform
quality: experimental

filter:
  - name: Device Type
    value: [SoC]
  - name: MCU
    value: [32-bit MCU]
  - name: Project Difficulty
    value: [Beginner]

readme:
  - path: ../README.md

source:
  - path: ../src/app.c
  - path: ../src/main.c

include:
  - path: ../inc
    file_list:
      - path: brd4186c/app.h
        condition: [brd4186c]
      - path: brd4270b/app.h
        condition: [brd4270b]
      - path: brd4400c/app.h
        condition: [brd4400c]
      - path: brd2506a/app.h
        condition: [brd2504a]
      - path: brd2504a/app.h
        condition: [brd2506a]
      - path: default/app.h
        condition: []

component:
  - id: sl_system
  - id: device_init
  - id: emlib_prs
  - id: hal_sysrtc
  - id: sl_system
  - instance: [led0]
    id: simple_led



define:
  - name: DEBUG_EFM

configuration:
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}

ui_hints:
  highlight:
    - path: README.md
      focus: true

other_file:
  - path: ../image/create_project.png
    directory: "image"  
