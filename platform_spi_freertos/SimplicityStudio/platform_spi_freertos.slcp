project_name: platform_spi_freertos
package: platform
label: Platform - SPI FreeRTOS
description: |
  This project demonstrates how to use SPI peripheral with FreeRTOS kernel on the XG21 part
category: Example|Platform
quality: experimental

filter:
   - name: Device Type
     value: [SoC]
   - name: MCU
     value: [32-bit MCU]
   - name: Project Difficulty
     value: [Beginner]

component:
  - id: clock_manager
  - id: device_init
  - id: emlib_usart
  - id: freertos
  - id: hal_usart
  - id: power_manager
  - instance: [led0]
    id: simple_led
  - id: sl_main
  - id: sleeptimer

readme:
- path: ../README.md

include:
- path: ../include
  file_list:
    - path: app.h
    - path: blink.h

source:
- path: ../src/main.c
- path: ../src/app.c
- path: ../src/blink.c

ui_hints:
  highlight:
    - path: README.md
      focus: true
      