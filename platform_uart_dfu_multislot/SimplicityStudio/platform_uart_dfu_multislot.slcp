project_name: platform_uart_dfu_multislot
package: platform
label: Platform - UART DFU Multislot
description: This project demonstrates device firmware upgrade over UART interface using multislot internal storage bootloader 
category: Example|Platform
quality: experimental

filter:
  - name: Device Type
    value: [SoC]
  - name: MCU
    value: [32-bit MCU]
  - name: Project Difficulty
    value: [Advanced]

component:
- id: bootloader_interface
- id: device_init
- id: emlib_usart
- id: sl_system

readme:
- path: ../README.md

include:
- path: ../inc
  file_list:
    - path: app.h
    - path: application_upgrade.h
    
source:
- path: ../src/main.c
- path: ../src/app.c
- path: ../src/application_upgrade.c

other_file:
- path: ../host_application/platform_uart_dfu_multislot_host.c
  directory: "host_application"
- path: ../images/project_selection.png
  directory: "images"
- path: ../images/bootloader_project_selection.png
  directory: "images"
- path: ../images/bootloader_storage_slot_setup.png
  directory: "images"

ui_hints:
  highlight:
    - path: README.md
      focus: true