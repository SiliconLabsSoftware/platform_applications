# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: platform_i2s_mic_vdac
label: Platform  - I2S Microphone VDAC

description: |
  This example project demonstrates the implementation of the I2S protocol for interfacing with a microphone. The sampled audio signal is routed to the VDAC analog pin.

category: Example|Platform
package: Platform
quality: experimmental

filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Beginner]

readme:
- path: ../README.md
source:
- path: ../src/app.c

include:
- path: ../inc
  file_list:
  - path: brd2601b/app.h
    condition: [brd2601b]
  - path: brd2608a/app.h
    condition: [brd2608a]

component:
- id: sl_main
- id: device_init
- id: dmadrv
- id: emlib_usart
- id: emlib_vdac

define:
  - name: DEBUG_EFM

other_file:
  - path: ../img/logic_2kHz_in.jpg
    directory: "img"
  - path: ../img/scope_2kHz_in.jpg
    directory: "img"

ui_hints:
  highlight:
  - path: README.md
    focus: true

